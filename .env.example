# ===========================================
# SIMAKSI — Environment Configuration
# ===========================================
# Copy file ini ke .env lalu isi sesuai environment kamu:
#   cp .env.example .env
#   php artisan key:generate
# ===========================================

APP_NAME=SIMAKSI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# Database — Gunakan MySQL
# ===========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=SIMAKSI
DB_USERNAME=root
DB_PASSWORD=

# ===========================================
# Session & Cache
# ===========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ===========================================
# SIMAKSI — API Services
# ===========================================
# Detection API (FastAPI + MegaDetector + ResNet-50)
# Jalankan: cd scripts/detection_api && uvicorn main:app --port 8001
DETECTION_API_URL=http://127.0.0.1:8001

# GEE MapBiomas Service (FastAPI + Google Earth Engine)
# Jalankan: cd scripts/gee_service && uvicorn main:app --port 8003
GEE_API_URL=http://127.0.0.1:8003

# ===========================================
# Mail (opsional, default log)
# ===========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@simaksi.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
