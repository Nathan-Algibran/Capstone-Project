# ===========================================
# SIMAKSI — .gitignore
# ===========================================
# File ini memastikan file sensitif dan
# generated files TIDAK masuk ke Git.
# Teman yang clone cukup jalankan:
#   1. composer install
#   2. npm install
#   3. cp .env.example .env → isi config DB
#   4. php artisan key:generate
#   5. php artisan migrate --seed
#   6. npm run dev
#   7. php artisan serve
# ===========================================

# --- Environment & Credentials ---
.env
.env.backup
.env.production
/auth.json
/storage/*.key

# GEE Service credentials (JANGAN commit!)
/scripts/gee_service/service-account-key.json
/scripts/gee_service/.env

# --- Dependencies (install sendiri) ---
/node_modules
/vendor
/scripts/gee_service/venv/

# --- Build output ---
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# --- Storage & Cache ---
/storage/pail
*.log

# --- Python ---
__pycache__/
*.pyc

# --- IDE & OS ---
.DS_Store
Thumbs.db
/.codex
/.cursor/
/.idea
/.nova
/.vscode
/.zed
.phpactor.json
.phpunit.result.cache
/.phpunit.cache
_ide_helper.php
Homestead.json
Homestead.yaml

# --- Docs (opsional, tidak perlu di repo) ---
AGENT.md
design.md
